#!/bin/sh
set -eu

case "$1" in
  remove|deconfigure)
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
      if [ -f /etc/systemd/system/uu-tailscale-relay-update.timer ]; then
        systemctl disable --now uu-tailscale-relay-update.timer
      fi
      deb-systemd-invoke stop uu-tailscale-relay.service
      systemctl disable uu-tailscale-relay.service
    fi
    ;;
esac
